#!/usr/bin/env sh

# ─────────────────────────────────────────────────────────────────────────────
# Pre-commit hook for clickhouse-monitor
# Runs: lint-staged (Biome format + lint) → root workspace type-check
# ─────────────────────────────────────────────────────────────────────────────

. "$(dirname "$0")/require-deps.sh"

# Run lint-staged for formatting and linting staged files
echo "🔍 Running lint-staged (Biome check on staged files)..."
pnpm exec lint-staged

# Root `type-check` (turbo) covers only the root workspace packages, NOT
# apps/dashboard: that app needs a generated routeTree, so CI type-checks it.
echo "📝 Running root workspace type-check (not apps/dashboard)..."
pnpm run type-check

echo "✅ Pre-commit checks passed!"
