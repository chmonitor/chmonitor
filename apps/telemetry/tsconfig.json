{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@chm/types/telemetry": ["../../packages/types/src/telemetry.ts"],
      "@chm/site-nav": ["../../packages/site-nav/src/index.ts"]
    }
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["./src/**/*.test.ts"]
}
