---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import FinalCta from '../components/FinalCta.astro'
import { btnOutline, btnPrimary } from '../lib/button-classes'
import CliDemo from '../components/CliDemo.astro'
import { CLI_DOCS, CLI_INSTALL, features } from '../data/cli'

const canonical = new URL(Astro.url.pathname, Astro.site).toString()

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'CLI', item: canonical },
  ],
}

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': `${canonical}#software`,
  name: 'chm',
  alternateName: 'chmonitor CLI',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS',
  license: 'https://opensource.org/licenses/MIT',
  url: canonical,
  downloadUrl: 'https://chmonitor.dev/install.sh',
  description:
    'chmonitor from the terminal. Talks straight to your chmonitor dashboard. Ready for AI Agents.',
  featureList: features.map((f) => f.title),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}

const ico = (d: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`
---
<Base
  title="chmonitor from the terminal"
  description="chmonitor talks straight to your chmonitor dashboard. Ready for AI Agents."
  image="/og/og-cli.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} is:inline />
  <Nav />
  <main id="top">
    <section class="band cli-intro" style="padding-bottom:0">
      <div class="wrap">
        <div class="sec-head price-head reveal" style="text-align:center">
          <span class="eyebrow">CLI</span>
          <h1>chmonitor from the terminal</h1>
          <p>chmonitor talks straight to your chmonitor dashboard. Ready for AI Agents.</p>
        </div>
        <div class="hero-actions reveal" style="margin-top:22px">
          <a class={btnPrimary} href="#install" data-cta="cli-install">
            Install
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
          </a>
          <a class={btnOutline} href={CLI_DOCS} target="_blank" rel="noopener" data-cta="cli-docs">
            CLI docs
          </a>
        </div>
      </div>
    </section>

    <CliDemo />

    <section class="band">
      <div class="wrap">
        <div class="cap-grid">
          {features.map((f) => (
            <div class="cap reveal">
              <span class="cap-ico" set:html={ico(f.icon)} />
              <h4>{f.title}</h4>
              <p>{f.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="install" class="band band-soft">
      <div class="wrap cli-install">
        <div class="sec-head reveal">
          <span class="eyebrow">Install</span>
          <h2>One command</h2>
          <p>Linux and macOS.</p>
        </div>
        <div class="terminal cli-term reveal">
          <div class="term-bar">
            <span class="lights"><i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i></span>
            <span class="ttl">bash</span>
            <button class="copy" type="button">Copy</button>
          </div>
          <div class="term-body">
            <div><span class="p">$</span> {CLI_INSTALL}</div>
          </div>
        </div>
      </div>
    </section>

    <FinalCta />
  </main>
  <Footer />
  <style>
    .price-head h1{font-size:clamp(1.75rem,6vw,2.5rem);line-height:1.1;letter-spacing:-.025em;font-weight:700;margin-top:14px}
    .price-head p{margin-inline:auto;font-size:clamp(14px,3.5vw,17px)}
    .cli-intro.band{padding-top:48px}
    .cli-install{max-width:820px;margin-inline:auto}
    .cli-term .term-body > div{white-space:pre-wrap}
    @media (max-width:880px){
      .cli-intro.band{padding-top:36px}
    }
  </style>
</Base>
