---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import FinalCta from '../components/FinalCta.astro'
import SponsorOffer from '../components/SponsorOffer.astro'
import {
  SPONSOR_CONTACT_EMAIL,
  sponsorMailto,
  sponsorTier,
  sponsors,
} from '../data/sponsors'
import { btnOutline } from '../lib/button-classes'

const heroFrom = sponsorTier('backer')

const canonical = new URL(Astro.url.pathname, Astro.site).toString()
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Sponsors', item: canonical },
  ],
}
---
<Base
  title="chmonitor Sponsors — fund the free build"
  description="Sponsor chmonitor. One-off $59, $99, or $199 puts your name on the sponsors page, and $99 or more puts your logo under the homepage hero."
  image="/og/og-pricing.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} is:inline />
  <Nav />
  <main id="top">
    <section class="band" style="padding-bottom:0">
      <div class="wrap">
        <div class="sec-head price-head" style="text-align:center">
          <span class="eyebrow">Sponsors</span>
          <h1>Who pays for the free build</h1>
          <p>
            chmonitor is GPL-3.0 and free to self-host. Sponsorship is not a
            license and buys no features — it is what keeps the releases coming,
            and it earns the logo under the homepage hero and this page.
          </p>
        </div>
      </div>
    </section>

    <section id="offer" class="band">
      <div class="wrap">
        <div class="offer reveal">
          <SponsorOffer />
          <p class="alt">
            <a class={btnOutline} href={sponsorMailto()}>Invoice or PO by email</a>
            <a class={btnOutline} href="/license">Compare with a license</a>
          </p>
        </div>
      </div>
    </section>

    <section id="the-wall" class="band">
      <div class="wrap">
        <h2 class="sec-h">Sponsor wall</h2>
        <ul class="wall">
          {
            sponsors.map((s) => (
              <li class="tile" data-sponsor-tier={s.tier}>
                <a
                  href={s.website}
                  target="_blank"
                  rel="noopener sponsored"
                  title={s.name}
                >
                  {s.logo ? (
                    <img
                      src={s.logo}
                      alt={s.name}
                      height="28"
                      loading="lazy"
                      decoding="async"
                      class="h-7 w-auto"
                    />
                  ) : (
                    <strong>{s.name}</strong>
                  )}
                </a>
                <span class="meta">
                  {sponsorTier(s.tier).label} · since {s.since}
                </span>
                {s.note && <span class="note">{s.note}</span>}
              </li>
            ))
          }
          {/* The next slot, same footprint as a filled tile. */}
          <li class="tile tile-open">
            <a
              href="#offer"
              data-sponsor-open-slot
              title={`Sponsor slot open — $${heroFrom.amountUsd} one-off`}
            >
              <span>+ your logo</span>
              <span class="meta">${heroFrom.amountUsd} · sponsor the free build</span>
            </a>
          </li>
        </ul>
        <p class="wall-note">
          Listing is by request: we add your name and website after you confirm,
          never before. Questions: <a href={`mailto:${SPONSOR_CONTACT_EMAIL}`}>{SPONSOR_CONTACT_EMAIL}</a>.
        </p>
      </div>
    </section>

    <FinalCta />
  </main>
  <Footer />

  {/* Paid? Polar sends the sponsor to /sponsors?sponsored=1&checkout_id=… .
      The page is static, so the confirmation is read from the URL here. */}
  <script is:inline>
    ;(function () {
      if (new URLSearchParams(window.location.search).get('sponsored') !== '1')
        return
      var lede = document.querySelector('#offer .details-lede')
      if (!lede) return
      var done = document.createElement('p')
      done.className = 'paid'
      done.setAttribute('role', 'status')
      done.textContent =
        'Payment received — thank you. We add your listing from the details Polar is holding, and you will see your logo here and under the homepage hero.'
      lede.parentNode.insertBefore(done, lede.nextSibling)
      lede.textContent =
        'Your details went to Polar with the payment, so we already have them. Nothing else to fill in.'
    })()
  </script>

  <style>
    .price-head h1{font-size:clamp(1.75rem,6vw,2.5rem);line-height:1.1;letter-spacing:-.025em;font-weight:700;margin-top:14px;text-wrap:balance}
    .price-head p{margin-inline:auto;font-size:clamp(14px,3.5vw,17px)}
    .sec-h{font-size:clamp(1.25rem,3vw,1.5rem);letter-spacing:-.02em;font-weight:700;margin:0 0 20px;text-align:center}
    .offer{max-width:640px;margin:0 auto}
    .alt{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px;justify-content:center}
    .paid{margin:0 0 14px;padding:12px 14px;border:1px solid var(--border);border-radius:var(--radius);background:var(--card);font-size:13.5px;line-height:1.55}

    .wall{list-style:none;padding:0;margin:0;display:grid;gap:10px;grid-template-columns:repeat(auto-fill,minmax(170px,1fr))}
    .tile{display:flex;flex-direction:column;justify-content:center;gap:3px;min-height:74px;padding:14px 16px;border:1px solid var(--border);border-radius:var(--radius);background:var(--card);text-align:center;align-items:center}
    .tile > a{display:flex;flex-direction:column;align-items:center;gap:2px;color:inherit;text-decoration:none;width:100%}
    .tile strong{font-size:16px;letter-spacing:-.01em}
    .tile .meta{font-size:11.5px;color:var(--muted-fg)}
    .tile .note{font-size:12.5px;color:var(--muted-fg)}
    .tile-open{border-style:dashed}
    .tile-open span:first-child{font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--muted-fg)}
    .tile-open a:hover{color:var(--orange)}
    .wall-note{margin-top:16px;text-align:center;font-size:13px;color:var(--muted-fg)}
    .wall-note a{color:var(--orange);text-decoration:underline;text-underline-offset:3px}
  </style>
</Base>
