---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'

const swatches = [
  { name: 'Blue', role: 'Primary accent · CTAs · links', hex: '#2563eb', token: '--primary' },
  { name: 'Amber', role: 'Metric bars · warm data ramp', hex: '#f59e0b', token: '--amber' },
  { name: 'Orange', role: 'Logo mark gradient', hex: '#f97316', token: '--orange' },
  { name: 'Emerald', role: 'Top-cap dot · healthy signal', hex: '#10b981', token: '--emerald' },
  { name: 'Ink', role: 'Mono mark · text', hex: '#09090b', token: '--fg' },
  { name: 'Paper', role: 'Mono mark on dark · surfaces', hex: '#fafafa', token: '--bg-soft' },
]

const MARK_SIZES = [16, 32, 64, 128, 256, 512, 1024]
const LOCKUP_SIZES = [208, 416, 832]

const pngFiles = (base: string, sizes: number[]) =>
  sizes.map((s) => ({ fmt: `PNG ${s}`, href: base.replace('{s}', String(s)) }))

// Every logo version exposes its SVG + PNG rasters; each file row is
// click-to-download with a copy-link button (see the downloads section).
const downloads = [
  {
    group: 'Mark',
    versions: [
      {
        name: 'Color',
        desc: 'Orange bars · emerald cap',
        preview: '/brand/logo-chmonitor.svg',
        files: [
          { fmt: 'SVG', href: '/brand/logo-chmonitor.svg' },
          ...pngFiles('/brand/logo-chmonitor-{s}.png', MARK_SIZES),
        ],
      },
      {
        name: 'Mono · ink',
        desc: 'Single ink (#09090b)',
        preview: 'mono-ink',
        files: [
          { fmt: 'SVG', href: '/brand/logo-chmonitor-mono-ink.svg' },
          { fmt: 'SVG', href: '/brand/logo-chmonitor-mono.svg' },
          ...pngFiles('/brand/logo-chmonitor-mono-{s}.png', MARK_SIZES),
        ],
      },
      {
        name: 'Mono · white',
        desc: 'Paper ink (#fafafa)',
        preview: 'mono-paper',
        files: [
          { fmt: 'SVG', href: '/brand/logo-chmonitor-mono-white.svg' },
          ...pngFiles('/brand/logo-chmonitor-mono-white-{s}.png', MARK_SIZES),
        ],
      },
    ],
  },
  {
    group: 'Lockup',
    versions: [
      {
        name: 'Light',
        desc: 'Ink wordmark · light surfaces',
        preview: '/brand/logo.svg',
        wide: true,
        files: [
          { fmt: 'SVG', href: '/brand/logo.svg' },
          ...pngFiles('/brand/logo-{s}.png', LOCKUP_SIZES),
        ],
      },
      {
        name: 'Dark',
        desc: 'Paper wordmark · dark surfaces',
        preview: '/brand/logo-dark.svg',
        wide: true,
        files: [
          { fmt: 'SVG', href: '/brand/logo-dark.svg' },
          ...pngFiles('/brand/logo-dark-{s}.png', LOCKUP_SIZES),
        ],
      },
    ],
  },
  {
    group: 'Avatar (circle)',
    versions: [
      {
        name: 'Color',
        desc: 'White circle · color mark',
        preview: '/brand/logo-chmonitor-avatar.svg',
        files: [
          { fmt: 'SVG', href: '/brand/logo-chmonitor-avatar.svg' },
          ...pngFiles('/brand/logo-chmonitor-avatar-{s}.png', MARK_SIZES),
        ],
      },
      {
        name: 'Solid',
        desc: 'Orange circle · paper mark',
        preview: '/brand/logo-chmonitor-avatar-solid.svg',
        files: [
          { fmt: 'SVG', href: '/brand/logo-chmonitor-avatar-solid.svg' },
          ...pngFiles('/brand/logo-chmonitor-avatar-solid-{s}.png', MARK_SIZES),
        ],
      },
      {
        name: 'Mono',
        desc: 'Transparent · ink mark',
        preview: '/brand/logo-chmonitor-avatar-mono.svg',
        files: [
          { fmt: 'SVG', href: '/brand/logo-chmonitor-avatar-mono.svg' },
          ...pngFiles('/brand/logo-chmonitor-avatar-mono-{s}.png', MARK_SIZES),
        ],
      },
      {
        name: 'White',
        desc: 'Transparent · paper mark',
        preview: '/brand/logo-chmonitor-avatar-white.svg',
        files: [
          { fmt: 'SVG', href: '/brand/logo-chmonitor-avatar-white.svg' },
          ...pngFiles('/brand/logo-chmonitor-avatar-white-{s}.png', MARK_SIZES),
        ],
      },
    ],
  },
]

const miscDownloads = [
  { group: 'Favicon & app icons', files: [
    { fmt: 'SVG', href: '/favicon.svg' },
    { fmt: 'ICO', href: '/favicon.ico' },
    { fmt: 'PNG 180', href: '/apple-touch-icon.png' },
    { fmt: 'PNG 512', href: '/icon-512.png' },
  ] },
  { group: 'Social', files: [{ fmt: 'PNG 1200×630', href: '/brand/og-brand.png' }] },
]

// Mono mark inlined so CSS `color` drives the ink/paper finish deterministically
// (an <img>-embedded SVG can't be themed by the page).
const monoMark = `<svg viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect x="3.3" y="9.75" width="3.8" height="3.3"/><rect x="3.3" y="13.95" width="3.8" height="14.55"/>
  <rect x="8.7" y="3.5" width="3.8" height="25"/><rect x="14.1" y="13.25" width="3.8" height="15.25"/>
  <rect x="19.5" y="6.25" width="3.8" height="22.25"/><rect x="24.9" y="16.8" width="3.8" height="11.7"/>
</svg>`
const canonical = new URL(Astro.url.pathname, Astro.site).toString()
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Brand', item: canonical },
  ],
}
---
<Base
  title="chmonitor Brand Kit — Logo, Colors & Usage Guide"
  description="The chmonitor brand kit: logo marks in SVG and PNG, brand colors, and usage guidelines. A flat metric-bar glyph with an emerald top-cap dot, free to download."
  image="/brand/og-brand.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} is:inline />
  <Nav />
  <main id="top">
    <!-- ── header ── -->
    <section class="hero band-brand">
      <div class="wrap">
        <p class="eyebrow">Brand</p>
        <h1 class="brand-title">A flat metric-bar mark<br />with an emerald top-cap dot.</h1>
        <p class="brand-sub">
          chmonitor's identity is five bars of varying height on ClickHouse's column grid — a
          monitor reading a cluster. The emerald cap on the left bar is the signal: healthy, live, watching.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary btn-sm" href="#downloads">Download assets</a>
          <a class="btn btn-ghost btn-sm" href="/brand/logo-chmonitor.svg" download>Mark (SVG)</a>
        </div>
      </div>
      <div class="wrap">
        <div class="brand-showcase"><img src="/brand/logo.svg" alt="chmonitor logo" width="312" height="66" /></div>
      </div>
    </section>

    <!-- ── the mark ── -->
    <section class="band">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">The mark</p>
          <h2>One glyph, three finishes</h2>
          <p>Color for product surfaces, single-ink mono for documents, and the same mono reversed for dark backgrounds.</p>
        </div>
        <div class="tiles">
          <figure class="tile">
            <div class="tile-art"><img src="/brand/logo-chmonitor.svg" alt="chmonitor color mark" width="92" height="92" /></div>
            <figcaption><strong>Color</strong><span>Orange bars · emerald cap</span></figcaption>
          </figure>
          <figure class="tile">
            <div class="tile-art mono-ink" set:html={monoMark}></div>
            <figcaption><strong>Mono · light</strong><span>Single ink (#09090b)</span></figcaption>
          </figure>
          <figure class="tile tile-dark">
            <div class="tile-art mono-paper" set:html={monoMark}></div>
            <figcaption><strong>Mono · dark</strong><span>Paper ink (#fafafa)</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ── lockup ── -->
    <section class="band band-soft">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">Lockup</p>
          <h2>Mark + wordmark</h2>
          <p>The wordmark is set lowercase in Geist SemiBold with tight tracking. Keep the mark roughly the cap-height of the word, with a gap of one bar's width.</p>
        </div>
        <div class="lockups">
          <div class="lockup"><img src="/brand/logo.svg" alt="chmonitor logo" width="208" height="44" /></div>
          <div class="lockup lockup-dark"><img src="/brand/logo-dark.svg" alt="chmonitor logo reversed" width="208" height="44" /></div>
        </div>
      </div>
    </section>

    <!-- ── color ── -->
    <section class="band">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">Color</p>
          <h2>Four values, one signal</h2>
          <p>Orange carries the bars, emerald is reserved for the "healthy / live" signal — never decoration. Ink and paper handle everything mono.</p>
        </div>
        <div class="swatches">
          {swatches.map((s) => (
            <div class="swatch">
              <span class="chip" style={`background:${s.hex}`}></span>
              <div class="meta">
                <strong>{s.name}</strong>
                <span class="mono">{s.hex}</span>
                <span class="role">{s.role}</span>
                <code class="mono token">{s.token}</code>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── usage ── -->
    <section class="band band-soft">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">Usage</p>
          <h2>Keep it honest</h2>
        </div>
        <div class="rules">
          <ul class="do">
            <li>Give the mark clear space of at least one bar-width on every side.</li>
            <li>Use the emerald cap only at its native position (top of the left bar).</li>
            <li>Prefer the SVG; fall back to the PNG / favicon where SVG isn't supported.</li>
            <li>On dark surfaces, use the reversed mono mark or the color mark as-is.</li>
          </ul>
          <ul class="dont">
            <li>Don't recolor the bars, add gradients, or restore the old tile / ping.</li>
            <li>Don't stretch, rotate, or reorder the bars — the heights are the identity.</li>
            <li>Don't pair the mark with the ClickHouse logo as if it were one brand.</li>
            <li>Don't set the wordmark in any face other than Geist.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ── downloads ── -->
    <section class="band" id="downloads">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">Downloads</p>
          <h2>Grab the files</h2>
          <p>Every version ships as SVG plus PNG rasters — click a file to download it, or the link icon to copy its URL. Everything is generated from one script (<span class="mono">scripts/build-brand-assets.ts</span>) so the kit never drifts from the mark.</p>
        </div>
        {downloads.map((d) => (
          <div class="dl-group">
            <h4>{d.group}</h4>
            <div class:list={['dl-cards', { two: d.versions.length === 2 }]}>
              {d.versions.map((v) => (
                <div class="dl-card">
                  <div class:list={['dl-art', { 'art-dark': v.preview === 'mono-paper' }]}>
                    {typeof v.preview === 'string' && v.preview.startsWith('/') ? (
                      v.wide ? (
                        <img src={v.preview} alt={`chmonitor ${d.group.toLowerCase()} — ${v.name}`} width="168" height="36" />
                      ) : (
                        <img src={v.preview} alt={`chmonitor ${d.group.toLowerCase()} — ${v.name}`} width="68" height="68" />
                      )
                    ) : (
                      <div class:list={['dl-mono', v.preview === 'mono-paper' ? 'mono-paper' : 'mono-ink']} set:html={monoMark} />
                    )}
                  </div>
                  <div class="dl-meta">
                    <strong>{v.name}</strong>
                    <span>{v.desc}</span>
                  </div>
                  <ul class="dl-files">
                    {v.files.map((f) => (
                      <li>
                        <a class="file-dl" href={f.href} download>
                          <span class="fmt">{f.fmt}</span>
                          <span class="fname">{f.href.split('/').pop()}</span>
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                        </a>
                        <button
                          class="copy-btn"
                          type="button"
                          data-copy={f.href}
                          aria-label={`Copy link to ${f.href.split('/').pop()}`}
                          title="Copy link"
                        >
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                        </button>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        ))}
        <div class="dl-group">
          <h4>Favicons &amp; social</h4>
          <div class="dl-cards two">
            {miscDownloads.map((d) => (
              <div class="dl-card">
                <div class="dl-meta"><strong>{d.group}</strong></div>
                <ul class="dl-files">
                  {d.files.map((f) => (
                    <li>
                      <a class="file-dl" href={f.href} download>
                        <span class="fmt">{f.fmt}</span>
                        <span class="fname">{f.href.split('/').pop()}</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                      </a>
                      <button
                        class="copy-btn"
                        type="button"
                        data-copy={f.href}
                        aria-label={`Copy link to ${f.href.split('/').pop()}`}
                        title="Copy link"
                      >
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script>
  const toast = document.createElement('div')
  toast.className = 'copy-toast'
  toast.setAttribute('role', 'status')
  document.body.appendChild(toast)

  const absoluteUrl = (path: string) => new URL(path, location.origin).href
  let toastTimer: ReturnType<typeof setTimeout> | undefined

  const showToast = (msg: string) => {
    toast.textContent = msg
    toast.classList.add('show')
    if (toastTimer) clearTimeout(toastTimer)
    toastTimer = setTimeout(() => toast.classList.remove('show'), 1800)
  }

  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const path = btn.dataset.copy
      if (!path) return
      const url = absoluteUrl(path)
      try {
        await navigator.clipboard.writeText(url)
        showToast(`Copied ${url}`)
      } catch {
        // Clipboard unavailable (permissions/insecure context) — surface the
        // URL so it can be copied manually.
        showToast(url)
      }
    })
  })
</script>

<style>
  .band-brand { padding: 64px 0 40px; }
  .brand-title { font-size: clamp(32px, 4.6vw, 52px); line-height: 1.06; letter-spacing: -.03em; font-weight: 700; margin-top: 16px; }
  .brand-sub { margin-top: 18px; max-width: 64ch; font-size: 17.5px; color: var(--muted-fg); text-wrap: pretty; }
  .band-brand .hero-actions { justify-content: flex-start; margin-top: 26px; }
  .brand-showcase { margin-top: 40px; display: flex; align-items: center; justify-content: center; height: 180px;
    border: 1px solid var(--border); border-radius: var(--radius); background: #fff; box-shadow: var(--shadow-card); }

  .tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 34px; }
  .tile { border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; background: #fff; box-shadow: var(--shadow-card); }
  .tile-art { display: flex; align-items: center; justify-content: center; height: 168px; }
  .tile-art :global(svg) { width: 92px; height: 92px; }
  .mono-ink { color: #09090b; }
  .mono-paper { color: #fafafa; }
  .tile-dark { background: #09090b; border-color: #1f1f23; }
  .tile figcaption { display: flex; flex-direction: column; gap: 2px; padding: 14px 16px; border-top: 1px solid var(--border-soft); }
  .tile-dark figcaption { border-top-color: #1f1f23; }
  .tile figcaption strong { font-size: 14px; font-weight: 600; }
  .tile figcaption span { font-size: 12.5px; color: var(--muted-fg); }
  .tile-dark figcaption strong { color: #fafafa; }
  .tile-dark figcaption span { color: #a1a1aa; }

  .lockups { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 30px; }
  .lockup { display: flex; align-items: center; padding: 30px 40px; border: 1px solid var(--border); border-radius: var(--radius);
    background: #fff; box-shadow: var(--shadow-card); }
  .lockup img { height: 36px; width: auto; }
  .lockup-dark { background: #09090b; border-color: #1f1f23; }

  .swatches { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 34px; }
  .swatch { border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; background: #fff; box-shadow: var(--shadow-card); }
  .swatch .chip { display: block; height: 96px; }
  .swatch .meta { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px; }
  .swatch .meta strong { font-size: 14px; font-weight: 600; }
  .swatch .meta .mono { font-size: 13px; color: var(--fg-soft); }
  .swatch .meta .role { font-size: 12px; color: var(--muted-fg); }
  .swatch .meta .token { font-size: 11.5px; color: var(--muted-fg); background: var(--muted); padding: 2px 6px; border-radius: 6px; width: fit-content; }

  .rules { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 30px; }
  .rules ul { list-style: none; padding: 22px 24px; border-radius: var(--radius); border: 1px solid var(--border); background: #fff; box-shadow: var(--shadow-card); }
  .rules li { position: relative; padding-left: 26px; font-size: 14.5px; color: var(--fg-soft); }
  .rules li + li { margin-top: 12px; }
  .rules li::before { position: absolute; left: 0; top: -1px; font-weight: 700; }
  .rules .do li::before { content: "✓"; color: var(--emerald); }
  .rules .dont li::before { content: "✕"; color: #ef4444; }

  .dl-group { margin-top: 34px; }
  .dl-group h4 { font-size: 13px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--muted-fg); margin-bottom: 14px; }
  .dl-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .dl-cards.two { grid-template-columns: repeat(2, 1fr); }
  .dl-card { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; background: #fff; box-shadow: var(--shadow-card); }
  .dl-art { display: flex; align-items: center; justify-content: center; height: 120px; border-bottom: 1px solid var(--border-soft); background:
    repeating-conic-gradient(#f4f4f5 0% 25%, #fff 0% 50%) 50% / 16px 16px; }
  .dl-art.art-dark { background: #09090b; border-bottom-color: #1f1f23; }
  .dl-art img { max-width: 80%; height: auto; }
  .dl-mono { width: 68px; height: 68px; }
  .dl-mono :global(svg) { width: 100%; height: 100%; }
  .mono-ink { color: #09090b; }
  .mono-paper { color: #fafafa; }
  .dl-meta { display: flex; flex-direction: column; gap: 1px; padding: 12px 16px 10px; }
  .dl-meta strong { font-size: 14px; font-weight: 600; }
  .dl-meta span { font-size: 12.5px; color: var(--muted-fg); }

  .dl-files { list-style: none; padding: 0 8px 8px; margin-top: auto; }
  .dl-files li { position: relative; display: flex; align-items: stretch; border-top: 1px solid var(--border-soft); }
  .file-dl { flex: 1; min-width: 0; display: flex; align-items: center; gap: 10px; padding: 7px 6px 7px 10px; font-size: 13px; color: var(--fg-soft); transition: color .15s, background .15s; }
  .file-dl:hover { color: var(--orange); background: color-mix(in oklab, var(--orange) 5%, transparent); }
  .file-dl .fmt { flex-shrink: 0; width: 64px; font-size: 11px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--muted-fg); background: var(--muted); padding: 2px 6px; border-radius: 6px; }
  .file-dl:hover .fmt { color: var(--orange); background: color-mix(in oklab, var(--orange) 10%, transparent); }
  .file-dl .fname { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .file-dl svg { flex-shrink: 0; width: 13px; height: 13px; margin-left: auto; opacity: .45; }
  .file-dl:hover svg { opacity: 1; }
  .copy-btn { flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; width: 30px; margin: 4px 4px 4px 0; border: 0; border-radius: 7px; background: transparent; color: var(--muted-fg); cursor: pointer; transition: color .15s, background .15s; }
  .copy-btn:hover { color: var(--fg); background: var(--muted); }
  .copy-btn svg { width: 13px; height: 13px; }

  .copy-toast { position: fixed; left: 50%; bottom: 28px; transform: translate(-50%, 12px); z-index: 60;
    pointer-events: none; opacity: 0; transition: opacity .18s, transform .18s;
    background: #09090b; color: #fafafa; font-size: 13px; padding: 9px 14px; border-radius: 9px;
    box-shadow: 0 8px 24px rgb(0 0 0 / .18); max-width: min(92vw, 560px); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .copy-toast.show { opacity: 1; transform: translate(-50%, 0); }

  @media (max-width: 860px) {
    .tiles, .swatches, .rules { grid-template-columns: 1fr 1fr; }
    .dl-cards, .dl-cards.two { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .tiles, .swatches, .rules { grid-template-columns: 1fr; }
    .dl-cards, .dl-cards.two { grid-template-columns: 1fr; }
  }
</style>
