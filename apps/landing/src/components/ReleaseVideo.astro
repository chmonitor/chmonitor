---
import type { ReleaseVideo } from '../data/release-videos'

interface Props {
  video: ReleaseVideo
}

const { video } = Astro.props
const watchUrl = `https://www.youtube.com/watch?v=${video.youtubeId}`
const poster = `https://i.ytimg.com/vi/${video.youtubeId}/maxresdefault.jpg`
---
<div class="cl-video">
  <a
    class="cl-video-poster"
    href={watchUrl}
    target="_blank"
    rel="noopener"
    data-release-video={video.youtubeId}
    data-release-video-title={video.title}
    aria-label={`Play ${video.title}`}
  >
    <img src={poster} alt={video.title} loading="lazy" decoding="async" />
    <span class="cl-video-play" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg>
    </span>
  </a>
  <a class="cl-video-link" href={watchUrl} target="_blank" rel="noopener">Watch on YouTube</a>
</div>

<style>
  .cl-video{margin-top:14px}
  .cl-video-poster,.cl-video :global(iframe){display:block;width:100%;aspect-ratio:16/9;border:1px solid var(--border);border-radius:10px;overflow:hidden;background:var(--muted)}
  .cl-video-poster{position:relative;transition:border-color .15s ease}
  .cl-video-poster:hover{border-color:var(--orange)}
  .cl-video-poster img{display:block;width:100%;height:100%;object-fit:cover}
  .cl-video-play{position:absolute;inset:0;margin:auto;width:64px;height:64px;border-radius:999px;display:grid;place-items:center;background:rgba(0,0,0,.6);color:#fff;transition:background .15s ease,transform .15s ease}
  .cl-video-play svg{width:28px;height:28px;margin-left:3px}
  .cl-video-poster:hover .cl-video-play{background:var(--orange);transform:scale(1.06)}
  .cl-video-link{display:inline-block;margin-top:8px;font-size:12.5px;color:var(--muted-fg);text-decoration:underline;text-underline-offset:3px}
  .cl-video-link:hover{color:var(--orange)}
</style>

<script>
  // Click-to-play facade: load the YouTube player only when asked. Modifier
  // clicks fall through to the plain youtube.com link. A bundled (non-inline)
  // script runs once per page, however many videos render.
  document.addEventListener('click', (event) => {
    const target = event.target
    const link =
      target instanceof Element
        ? target.closest<HTMLElement>('[data-release-video]')
        : null
    if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return
    event.preventDefault()
    const iframe = document.createElement('iframe')
    iframe.src = `https://www.youtube-nocookie.com/embed/${link.dataset.releaseVideo}?autoplay=1&rel=0`
    iframe.title = link.dataset.releaseVideoTitle || 'Release video'
    iframe.allow =
      'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen'
    iframe.allowFullscreen = true
    link.replaceWith(iframe)
  })
</script>
