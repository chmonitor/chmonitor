---
import { ALERT_CHANNELS_SHORT } from '../data/alert-channels'
import { getLatestBlogPost } from '../lib/latest-blog-post'

const HERO_VIDEO = '/assets/videos/chmonitor-v0.3.mp4'
const HERO_POSTER = '/assets/videos/chmonitor-v0.3-poster.jpg'
const HERO_POSTER_ALT =
  'chmonitor v0.3: Overview with query heatmap, charts and cluster health'

const HERO_FEATURES = [
  'Real-time queries, merges and replication from system tables',
  'Running, slow and expensive query views with EXPLAIN',
  'Cluster topology, replica lag and Keeper health',
  'Disk, memory and merge backlog on one overview',
  `Threshold alerts to ${ALERT_CHANNELS_SHORT}`,
  'AI advisor for schema and tuning — MCP-ready, read-only default',
] as const

const latestPost = getLatestBlogPost()

const checkSvg = `<svg class="mt-0.5 size-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7"/></svg>`
const arrowSvg = `<svg class="size-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>`
---

<section class="relative isolate overflow-hidden -mt-16 pt-16 pb-14 sm:pb-16 md:pb-[56px]" data-hero>
  {/* Pull the section up under the 64px sticky, transparent nav (-mt-16) and add
      an equal pt-16 so the CONTENT stays put — this lets the ambient wash below
      (absolute inset-0) reach the very top edge, behind the nav. */}
  {/* Ambient field: the brand bar-chart motif tessellated as a faint skyline,
      under a single brand wash off the top edge. The pattern is masked to fade
      out toward the center so text and the screenshot stay on a clean canvas —
      it only breathes at the edges. No grid, no second hue. */}
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    aria-hidden="true"
  >
    <svg
      class="absolute inset-0 h-full w-full text-[var(--brand)]"
      preserveAspectRatio="xMidYMid slice"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        {/* One tile of the six-bar chmonitor motif, anchored to the tile
            baseline so tiling reads as a continuous equalizer skyline. */}
        <pattern id="hero-bars" width="88" height="140" patternUnits="userSpaceOnUse">
          <g fill="currentColor">
            <rect x="6" y="112" width="8" height="28" />
            <rect x="20" y="44" width="8" height="96" />
            <rect x="34" y="88" width="8" height="52" />
            <rect x="48" y="24" width="8" height="116" />
            <rect x="62" y="72" width="8" height="68" />
            <rect x="76" y="100" width="8" height="40" />
          </g>
        </pattern>
        {/* Keep the center clear; let the pattern surface toward the edges. */}
        <radialGradient id="hero-bars-fade" cx="50%" cy="34%" r="72%">
          <stop offset="0%" stop-color="black" />
          <stop offset="55%" stop-color="black" />
          <stop offset="100%" stop-color="white" />
        </radialGradient>
        <mask id="hero-bars-mask">
          <rect width="100%" height="100%" fill="url(#hero-bars-fade)" />
        </mask>
      </defs>
      <rect
        width="100%"
        height="100%"
        fill="url(#hero-bars)"
        mask="url(#hero-bars-mask)"
        opacity="0.05"
      />
    </svg>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_45%_at_50%_-15%,var(--brand-soft),transparent_62%)]"></div>
  </div>

  <div class="relative mx-auto max-w-[1080px] px-4 sm:px-6 pt-12 sm:pt-16 lg:pt-20">
    <div class="mx-auto max-w-3xl text-center">
      {
        latestPost && (
          <a
            href={latestPost.href}
            target="_blank"
            rel="noopener"
            title={latestPost.title}
            class="inline-flex min-w-0 max-w-full"
            data-hero-latest-post
          >
            {/* Title + arrow. One line; ellipsis on narrow screens so the
                arrow stays visible. Full title is on `title` for hover. */}
            <span class="inline-flex min-w-0 max-w-full items-center gap-1.5 rounded-full bg-[var(--surface-strong)] px-3 py-1 text-foreground text-xs font-medium leading-none transition-colors hover:bg-[var(--hairline-strong)]">
              <span class="min-w-0 truncate">{latestPost.title}</span>
              <span class="shrink-0" set:html={arrowSvg} />
            </span>
          </a>
        )
      }

      {/* Display stays at weight 400 with negative tracking — the editorial
          voice depends on it. Do not bold. */}
      <h1 class="mt-5 sm:mt-8 text-balance font-normal text-[clamp(1.5rem,4.5vw,2.75rem)] text-foreground leading-[1.05] tracking-[-0.03em]">
        The ops dashboard<br class="hidden sm:block" /> for <span class="text-[var(--brand)]">ClickHouse</span>.
      </h1>

      <p class="mx-auto mt-6 sm:mt-8 max-w-xl text-pretty text-muted-foreground text-lg sm:text-xl leading-relaxed tracking-[0.005em]">
        Monitor queries, merges, parts, replication, and health. An AI advisor on top — open source, self-host free.
      </p>
    </div>

    {/* Launch film as the hero intro. Poster is the LCP image; the video
        autoplays muted and loops when motion is allowed. Reduced-motion and
        failed playback keep the poster. */}
    <div
      class="mt-12 sm:mt-16 overflow-hidden rounded-xl hero-shot-frame"
      data-hero-video
    >
      <video
        class="block h-auto w-full bg-transparent"
        poster={HERO_POSTER}
        width="1920"
        height="1126"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        disablepictureinpicture
        disableremoteplayback
        aria-label={HERO_POSTER_ALT}
        data-hero-intro
      >
        <source src={HERO_VIDEO} type="video/mp4" />
      </video>
      <img
        src={HERO_POSTER}
        alt={HERO_POSTER_ALT}
        width="1920"
        height="1126"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        data-hero-poster
        class="hidden h-auto w-full"
      />
    </div>

    <ul
      class="mx-auto mt-12 sm:mt-16 grid max-w-3xl list-none gap-x-10 gap-y-3 sm:gap-y-3.5 sm:grid-cols-2 pt-8 sm:pt-10"
      data-hero-features
    >
      {
        HERO_FEATURES.map((feature) => (
          <li class="flex gap-2.5 text-left text-[13px] sm:text-sm leading-snug">
            <span class="mt-0.5 size-3.5 shrink-0 text-[var(--semantic-success)]" set:html={checkSvg} />
            <span class="text-muted-foreground">{feature}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <script is:inline>
    (function () {
      var wrap = document.querySelector('[data-hero-video]')
      if (!wrap) return
      var video = wrap.querySelector('[data-hero-intro]')
      var poster = wrap.querySelector('[data-hero-poster]')
      if (!video) return
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      var showPoster = function () {
        video.style.display = 'none'
        if (poster) poster.classList.remove('hidden')
      }
      if (reduce) {
        showPoster()
        return
      }
      var play = function () {
        var p = video.play()
        if (p && typeof p.catch === 'function') p.catch(showPoster)
      }
      video.addEventListener('error', showPoster)
      if (video.readyState >= 2) play()
      else video.addEventListener('loadeddata', play, { once: true })
    })()
  </script>

  {/* Scroll-linked settle: the shot frame starts a touch larger than rest size
      and eases down to 1 over the first ~360px of scroll. Pure transform (no
      layout/CLS); the section's overflow-hidden clips the enlarged edges. */}
  <script is:inline>
    (function () {
      var frame = document.querySelector('[data-hero-video]')
      if (!frame) return
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
      var MAX = 0.045
      var RANGE = 360
      var ticking = false
      var apply = function () {
        ticking = false
        var p = Math.min(Math.max(window.scrollY, 0) / RANGE, 1)
        frame.style.setProperty('--hero-shot-scale', (1 + MAX * (1 - p)).toFixed(4))
      }
      window.addEventListener('scroll', function () {
        if (!ticking) {
          ticking = true
          requestAnimationFrame(apply)
        }
      }, { passive: true })
      apply()
    })()
  </script>

  <style>
    .hero-shot-frame {
      transform: scale(var(--hero-shot-scale, 1.045));
      transform-origin: 50% 0;
      will-change: transform;
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-shot-frame {
        transform: none;
      }
    }
  </style>
</section>
