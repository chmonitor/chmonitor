---
import {
  heroSponsors,
  SPONSOR_TIERS,
  sponsorTier,
} from '../data/sponsors'
import { DEFAULT_SPONSOR_TIER } from '@chm/pricing'

/** Tiers that earn the hero slot. The cheapest one sets the advertised price. */
const heroFrom = sponsorTier(
  SPONSOR_TIERS.find((tier) => tier.hero)?.id ?? DEFAULT_SPONSOR_TIER
)
const sponsors = heroSponsors()
---
{/* Sponsor line at the foot of the hero, under the feature list. The open slot
    is a compact dashed tile — the same footprint a real logo would take — so
    the invitation reads as part of the row rather than a card competing with
    it. */}
<div class="mt-12 border-t border-border pt-7 sm:mt-14" data-sponsor-slot>
  <p class="text-center text-[11px] font-medium uppercase tracking-[0.14em] text-muted-foreground">
    Sponsored by
  </p>

  <ul class="mt-4 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
    {
      sponsors.map((s) => (
        <li>
          <a
            class="flex h-11 w-28 items-center justify-center rounded-lg border border-[var(--hairline-strong)] px-2 transition-colors hover:bg-[var(--surface-strong)]"
            href={s.website}
            target="_blank"
            rel="noopener sponsored"
            title={s.name}
          >
            {s.logo ? (
              <img
                src={s.logo}
                alt={s.name}
                height="28"
                loading="lazy"
                decoding="async"
                class="h-7 w-auto"
              />
            ) : (
              <span class="text-sm font-semibold tracking-tight text-foreground">
                {s.name}
              </span>
            )}
          </a>
        </li>
      ))
    }

    {/* The open slot. Same box as a sponsor logo, dashed, and a link. */}
    <li>
      <a
        class="flex h-11 w-28 flex-col items-center justify-center rounded-lg border border-dashed border-[var(--hairline-strong)] px-2 text-center transition-colors hover:bg-[var(--surface-strong)]"
        href="/license#sponsor"
        data-sponsor-placeholder
        data-cta="hero-become-sponsor"
        title={`Sponsor slot open — $${heroFrom.amountUsd} one-off puts your logo here`}
      >
        <span class="text-[11px] font-medium uppercase tracking-[0.08em] text-muted-foreground">
          + your logo
        </span>
        <span class="text-[10px] text-muted-foreground opacity-75">
          ${heroFrom.amountUsd}
        </span>
      </a>
    </li>
  </ul>
</div>
