---
import {
  DEFAULT_SPONSOR_TIER,
  isSponsorEmailAcceptable,
  sponsorCheckoutAction,
  sponsorHref,
  SPONSOR_TIERS,
  sponsorTier,
} from '../data/sponsors'
import { btnOutline, btnPrimary } from '../lib/button-classes'

/**
 * The sponsorship offer: one card per tier, then the form that fills it in.
 *
 *   Add my details → checks that tier in the form and jumps to it
 *   Pick $N        → straight to the payment, nothing collected. One click.
 *
 * The form is two labelled groups — "Pick the plan" and "Information
 * (Optional)" — and it GET-submits to the checkout route itself, so the fields
 * reach the payment provider with or without JavaScript. The script only keeps
 * the amount input, the plan radios, and the button label in sync, and blocks an
 * unusable email before a checkout is created.
 *
 * One level of card (the tiers) and a hairline before the form. Everything
 * left-aligned and full width — no box-in-a-box. Used on /license#sponsor and
 * /sponsors, so the two surfaces can never disagree about a price.
 */
const defaultTier = sponsorTier(DEFAULT_SPONSOR_TIER)
const action = sponsorCheckoutAction()
const amountLabel = (usd: number) => `$${usd.toLocaleString('en-US')}`
---

<ul class="tiers">
  {
    SPONSOR_TIERS.map((tier) => (
      <li
        class:list={['tier', tier.highlight && 'is-featured']}
        data-tier={tier.id}
      >
        <p class="tier-head">
          <span class="amt">{amountLabel(tier.amountUsd)}</span>
          <span class="tier-name">{tier.label}</span>
          {tier.highlight && <span class="tier-badge">Most chosen</span>}
        </p>
        <p class="tier-pitch">{tier.pitch}</p>
        <div class="tier-cta">
          <button
            type="button"
            class={tier.highlight ? btnPrimary : btnOutline}
            data-add-details={tier.id}
            data-cta={`sponsor-details-${tier.id}`}
          >
            Add my details
          </button>
          <a
            class={btnOutline}
            href={sponsorHref(tier.amountUsd)}
            data-cta={`sponsor-pick-${tier.id}`}
          >
            Pick {amountLabel(tier.amountUsd)}
          </a>
        </div>
      </li>
    ))
  }
</ul>

<form
  class="details"
  id="sponsor-details"
  method="get"
  action={action}
  data-default-tier={defaultTier.id}
>
  <div class="group" role="group" aria-labelledby="sponsor-plan-label">
    <p class="group-label" id="sponsor-plan-label">Pick the plan</p>
    <div class="tier-radios" role="radiogroup" aria-label="Sponsorship amount">
      {
        SPONSOR_TIERS.map((tier) => (
          <label class="radio" data-radio-tier={tier.id}>
            <input
              type="radio"
              name="tier"
              value={tier.id}
              checked={tier.id === defaultTier.id}
            />
            <span>{amountLabel(tier.amountUsd)}</span>
          </label>
        ))
      }
      <label class="radio radio-custom">
        <span class="sr-only">Custom amount in US dollars</span>
        <span class="radio-prefix" aria-hidden="true">$</span>
        <input
          class="amount"
          type="number"
          name="amount"
          min="1"
          step="1"
          inputmode="decimal"
          placeholder="Other"
          aria-label="Custom amount in US dollars"
          data-custom-amount
        />
      </label>
    </div>
  </div>

  <div class="group" role="group" aria-labelledby="sponsor-info-label">
    <p class="group-label" id="sponsor-info-label">
      Information <span class="opt">(Optional)</span>
    </p>
    <div class="fields">
      <label>
        <span class="lab">Name</span>
        <input
          type="text"
          name="name"
          maxlength="120"
          placeholder="Acme Analytics"
          autocomplete="organization"
        />
      </label>
      <label>
        <span class="lab">Website</span>
        <input
          type="url"
          name="website"
          maxlength="200"
          placeholder="https://acme.com"
          autocomplete="url"
        />
      </label>
      <label>
        <span class="lab">Email</span>
        <input
          type="email"
          name="email"
          maxlength="200"
          placeholder="ops@acme.com"
          autocomplete="email"
          aria-describedby="sponsor-email-error"
        />
        <span class="err" id="sponsor-email-error" data-email-error hidden></span>
      </label>
      <label>
        <span class="lab">Logo URL <span class="opt">(optional)</span></span>
        <input
          type="url"
          name="logo"
          maxlength="300"
          placeholder="https://acme.com/logo.svg"
          autocomplete="off"
        />
      </label>
    </div>
  </div>

  <button
    class={btnPrimary}
    type="submit"
    data-label="Sponsor {amount} and continue to payment"
    data-cta="sponsor-submit"
  >
    Sponsor {amountLabel(defaultTier.amountUsd)} and continue to payment
  </button>
  <p class="hint">
    Your details go with the payment, so we can add you to the wall without a
    follow-up email. We publish the name and website link; the email is only
    used for the receipt.
  </p>
</form>

<script
  is:inline
  define:vars={{
    tiers: SPONSOR_TIERS.map((t) => ({ id: t.id, amountUsd: t.amountUsd })),
    acceptable: isSponsorEmailAcceptable,
  }}
>
  ;(function () {
    var form = document.getElementById('sponsor-details')
    if (!form) return
    var amount = form.querySelector('[data-custom-amount]')
    var submit = form.querySelector('[type=submit]')
    // The server-rendered label carries the default price; the template below
    // is what the script re-renders so the amount can never contradict it.
    var base = submit ? submit.getAttribute('data-label') || '' : ''

    function price() {
      var custom = amount && String(amount.value || '').trim()
      if (custom) {
        var n = Number(custom)
        if (Number.isFinite(n) && n > 0) return n
        return null
      }
      var checked = form.querySelector('input[name=tier]:checked')
      var found =
        checked && tiers.filter(function (t) { return t.id === checked.value })[0]
      return found ? found.amountUsd : null
    }

    function label() {
      var p = price()
      if (!submit || !base) return
      submit.textContent = base.replace(
        '{amount}',
        p ? '$' + p.toLocaleString('en-US') : '—'
      )
    }

    // A custom amount wins over the plan radios, and vice versa: exactly one
    // source of truth for the price, in both directions.
    if (amount) {
      amount.addEventListener('input', function () {
        if (String(amount.value || '').trim()) {
          form.querySelectorAll('input[name=tier]').forEach(function (r) {
            r.checked = false
          })
        }
        label()
      })
    }
    form.querySelectorAll('input[name=tier]').forEach(function (radio) {
      radio.addEventListener('change', function () {
        if (radio.checked && amount) amount.value = ''
        label()
      })
    })

    document.querySelectorAll('[data-add-details]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var tier = btn.getAttribute('data-add-details')
        var radio = form.querySelector('input[name=tier][value="' + tier + '"]')
        if (radio) {
          radio.checked = true
          if (amount) amount.value = ''
        }
        label()
        form.scrollIntoView({ behavior: 'smooth', block: 'center' })
        var first = form.querySelector('input[name=name]')
        if (first) first.focus({ preventScroll: true })
      })
    })

    /* Blocks an unusable email before a checkout is created: the provider
       rejects the whole checkout when it cannot attach a customer to the
       address, so a placeholder domain would otherwise leave the sponsor on a
       gateway error instead of a message. Everything else stays optional: a
       blank form is still just a pick. */
    var emailEl = form.querySelector('input[name=email]')
    var emailErr = form.querySelector('[data-email-error]')
    function showEmailError(message) {
      if (!emailErr) return
      emailErr.textContent = message || ''
      emailErr.hidden = !message
    }
    if (emailEl) {
      emailEl.addEventListener('input', function () {
        if (String(emailEl.value || '').trim()) showEmailError('')
      })
    }
    form.addEventListener('submit', function (e) {
      if (!price()) {
        e.preventDefault()
        showEmailError('')
        if (amount) amount.focus()
        return
      }
      if (!emailEl) return
      var value = String(emailEl.value || '').trim()
      if (!value) {
        showEmailError('')
        return
      }
      if (!emailEl.checkValidity()) {
        e.preventDefault()
        showEmailError('That does not look like an email address.')
        emailEl.focus()
        return
      }
      if (!acceptable(value)) {
        e.preventDefault()
        showEmailError(
          'We cannot send a receipt to that domain — use the address you actually read.'
        )
        emailEl.focus()
        return
      }
      showEmailError('')
    })

    label()
  })()
</script>

<style>
  /* One level of card. The tiers are the boxes; the form is a hairline away.
     auto-fit, not a fixed column count: a fourth or fifth rung needs no CSS. */
  .tiers{list-style:none;padding:0;margin:0;width:100%;display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(min(100%,212px),1fr));text-align:left;align-items:stretch}
  .tier{display:flex;flex-direction:column;gap:6px;padding:20px 18px;border:1px solid var(--border);border-radius:var(--radius);background:var(--card)}
  .tier.is-featured{border-color:color-mix(in oklch, var(--brand) 40%, var(--border))}
  .tier-head{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;margin:0}
  .tier .amt{font-size:28px;font-weight:800;letter-spacing:-.03em;line-height:1}
  .tier-name{font-weight:700;font-size:15px;letter-spacing:-.01em;color:var(--fg)}
  .tier-badge{font-size:10.5px;font-weight:600;border:1px solid var(--border);border-radius:999px;padding:2px 7px;background:var(--muted, rgba(127,127,127,.1));color:var(--muted-fg);white-space:nowrap}
  .tier-pitch{margin:0 0 6px;font-size:13.5px;line-height:1.55;color:var(--muted-fg);flex:1}
  .tier-cta{display:flex;flex-direction:column;gap:8px;margin-top:auto}

  .details{width:100%;margin-top:32px;padding-top:28px;border-top:1px solid var(--border);text-align:left}
  .group + .group{margin-top:24px}
  /* Quiet section marker — the same voice as the landing eyebrow. */
  .group-label{margin:0 0 12px;font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--muted-fg)}
  .group-label .opt{font-weight:400;letter-spacing:.06em;text-transform:none}

  .tier-radios{display:flex;flex-wrap:wrap;align-items:center;gap:8px}
  .radio{display:inline-flex;align-items:center;gap:7px;min-height:40px;padding:0 14px;border:1px solid var(--border);border-radius:var(--radius);background:var(--card);font-size:14px;font-weight:600;color:var(--fg);cursor:pointer}
  .radio:has(input:checked){border-color:var(--brand);box-shadow:inset 0 0 0 1px var(--brand)}
  .radio input{margin:0;accent-color:var(--brand)}
  .radio-prefix{color:var(--muted-fg)}
  .radio-custom{gap:2px;padding:0 12px}
  .radio-custom .amount{width:5.5rem;min-height:38px;border:0;background:transparent;font:inherit;font-weight:600;outline:none;color:var(--fg)}

  .fields{display:grid;gap:14px 16px;grid-template-columns:1fr}
  @media (min-width:560px){.fields{grid-template-columns:1fr 1fr}}
  @media (min-width:1000px){.fields{grid-template-columns:repeat(4,1fr)}}
  .fields label{display:flex;flex-direction:column;gap:6px;min-width:0}
  .fields .lab{display:flex;align-items:baseline;gap:5px;font-size:12.5px;font-weight:600;color:var(--fg)}
  .fields .opt{font-weight:400;color:var(--muted-fg)}
  .fields input{font:inherit;font-weight:400;min-height:44px;padding:10px 12px;border:1px solid var(--border);border-radius:8px;background:var(--bg);color:var(--fg)}
  .fields .err{font-size:12px;font-weight:500;color:var(--orange)}
  .fields .err[hidden]{display:none}
  .details > [type=submit]{margin-top:24px}
  .hint{margin:10px 0 0;max-width:70ch;font-size:12.5px;line-height:1.6;color:var(--muted-fg)}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
</style>
