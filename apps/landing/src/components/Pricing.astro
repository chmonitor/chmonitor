---
// Primary: self-hosted licenses (yearly / lifetime). Cloud SaaS cards stay
// available on /pricing#cloud for people who do not want to operate the app.
import { buyHref, licenseSkus } from '../data/licenses'
import {
  btnInkBlock,
  btnOutline,
  btnPrimaryBlock,
} from '../lib/button-classes'

const checkSvg = `<svg class="inline-block size-4 shrink-0 align-middle text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg>`
const arrowSvg = `<svg class="inline-block size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>`

const { compact = false } = Astro.props

const FEATURED_COLOR =
  'bg-card border-[var(--brand)]/40 ring-1 ring-[var(--brand)]/20'
const DEFAULT_COLOR = 'bg-[var(--canvas-soft)] border-border'
---
<section id="pricing" class="py-14 sm:py-18">
  <div class="mx-auto max-w-[1080px] px-4 sm:px-6">
    {!compact && (
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="font-mono text-xs font-medium uppercase tracking-[0.14em] text-muted-foreground">Pricing</p>
      <h2 class="mt-3 text-balance font-extrabold text-2xl sm:text-3xl md:text-4xl tracking-[-0.04em]">Self-host free. License if you want a commercial agreement.</h2>
      <p class="mt-4 text-pretty text-sm sm:text-base text-muted-foreground">Run it on your infra under GPL-3.0, no key required. Teams that need an invoice, support, or a named vendor buy a host-based license — yearly or lifetime. We trust you; there is no DRM.</p>
    </div>
    )}

    <div class="reveal mt-8 sm:mt-8 flex flex-wrap items-center justify-between gap-3 sm:gap-4">
      <div class="bill-toggle inline-flex w-full sm:w-auto gap-0.5 rounded-full bg-muted p-1" role="tablist" aria-label="License term">
        <button type="button" data-term="yearly" role="tab" aria-selected="true" class="billing-toggle-btn active flex-1 sm:flex-none inline-flex items-center justify-center gap-2 rounded-full px-4 py-2 sm:py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground active:scale-[.98] border-0 border-transparent outline-none">Yearly</button>
        <button type="button" data-term="lifetime" role="tab" aria-selected="false" class="billing-toggle-btn flex-1 sm:flex-none inline-flex items-center justify-center gap-2 rounded-full px-4 py-2 sm:py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground active:scale-[.98] border-0 border-transparent outline-none">
          Lifetime <span class="save text-xs font-semibold">pay once</span>
        </button>
      </div>
    </div>

    <div class="license-grid reveal mt-5 grid items-stretch gap-3 sm:gap-4 sm:grid-cols-2 lg:grid-cols-3" data-term="yearly">
      {licenseSkus.map((sku) => (
        <div class={`flex flex-col rounded-xl border p-5 sm:p-6 shadow-xs transition-colors ${sku.highlight ? FEATURED_COLOR : DEFAULT_COLOR}`}>
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <span class="font-bold text-lg tracking-tight">{sku.displayName}</span>
              {sku.id === 'personal' && (
                <span class="inline-flex items-center gap-1 rounded-full border border-border bg-neutral-100 px-2.5 py-0.5 text-xs font-medium text-neutral-800 dark:bg-neutral-800 dark:text-neutral-200">Free · GPL-3.0</span>
              )}
              {sku.highlight && (
                <span class="inline-flex items-center gap-1 rounded-full border border-border bg-neutral-100 px-2.5 py-0.5 text-xs font-medium text-neutral-800 dark:bg-neutral-800 dark:text-neutral-200">Most teams</span>
              )}
            </div>
            <div class="pamount mt-4 flex items-baseline gap-1.5">
              {sku.yearlyUsd === 0 ? (
                <span class="font-extrabold text-4xl tracking-[-0.04em]">$0</span>
              ) : (
                <>
                  <span class="amt amt-yearly font-extrabold text-4xl tracking-[-0.04em]">${sku.yearlyUsd} <small class="text-sm font-normal text-muted-foreground">/ yr</small></span>
                  <span class="amt amt-lifetime font-extrabold text-4xl tracking-[-0.04em]">${sku.lifetimeUsd} <small class="text-sm font-normal text-muted-foreground">once</small></span>
                </>
              )}
            </div>
            <div class="pbilled mt-2 min-h-[1rem] text-xs text-muted-foreground">
              {sku.yearlyUsd === 0 ? (
                <span>unlimited hosts · self-host</span>
              ) : (
                <>
                  <span class="bill-yearly">{sku.hosts === null ? 'unlimited hosts' : `${sku.hosts} hosts`} · billed yearly</span>
                  <span class="bill-lifetime">{sku.hosts === null ? 'unlimited hosts' : `${sku.hosts} hosts`} · one-time</span>
                </>
              )}
            </div>
            <p class="mt-3 min-h-10 text-pretty text-sm text-muted-foreground">{sku.tagline}</p>
          </div>
          <ul class="mt-6 space-y-2.5">
            {sku.highlights.map((r) => (
              <li class="flex items-start gap-2 text-sm text-foreground">
                <span class="inline-flex items-center justify-center size-4 shrink-0" set:html={checkSvg} />
                <span>{r}</span>
              </li>
            ))}
          </ul>
          <div class="mt-auto pt-6 flex flex-col gap-2">
            <a
              class={sku.highlight ? btnPrimaryBlock : btnInkBlock}
              href={buyHref(sku, 'yearly')}
              data-cta={`license-${sku.id}-yearly`}
              data-buy-yearly={buyHref(sku, 'yearly')}
              data-buy-lifetime={buyHref(sku, 'lifetime')}
            >
              {sku.yearlyUsd === 0 ? 'Self-host' : `Buy ${sku.name}`} <span class="inline-flex items-center justify-center size-4 shrink-0" set:html={arrowSvg} />
            </a>
          </div>
        </div>
      ))}
    </div>

    <p class="reveal mt-5 text-center text-sm text-muted-foreground">
      After payment, register your company name and website. Listing on the <a class="text-primary underline underline-offset-4" href="/customers">customers page</a> is optional.
    </p>

    {!compact && (
    <div class="reveal mt-7 text-center">
      <a class={btnOutline} href="/pricing">
        Compare licenses &amp; hosted cloud <span class="inline-flex items-center justify-center size-4 shrink-0" set:html={arrowSvg} />
      </a>
    </div>
    )}
  </div>

  <style>
    .billing-toggle-btn {
      border: 0 !important;
      outline: none !important;
      box-shadow: none !important;
      background: transparent;
      /* Native <button> color is ButtonText (near-black) — set ink so the
         unselected tab is readable when .active is removed. */
      color: var(--muted-foreground);
    }
    /* Segmented control — not a CTA. Do not use --primary (pure white in dark). */
    .billing-toggle-btn.active {
      background: var(--card);
      color: var(--foreground) !important;
      box-shadow: 0 0 0 1px var(--border);
    }
    .billing-toggle-btn.active .save {
      color: var(--muted-foreground);
    }
    .billing-toggle-btn:not(.active) .save {
      color: var(--semantic-success);
    }
    :global([data-theme='dark']) .billing-toggle-btn.active {
      background: var(--surface-strong);
      color: var(--foreground);
      box-shadow: 0 0 0 1px var(--hairline-strong);
    }
    :global([data-theme='dark']) .billing-toggle-btn.active .save {
      color: var(--muted-foreground);
    }

    .license-grid .amt { display: none; }
    .license-grid[data-term='yearly'] .amt-yearly { display: inline; }
    .license-grid[data-term='lifetime'] .amt-lifetime { display: inline; }
    .license-grid[data-term='yearly'] .bill-lifetime { display: none; }
    .license-grid[data-term='lifetime'] .bill-yearly { display: none; }
  </style>

  <script is:inline>
    (function () {
      var grid = document.querySelector('.license-grid')
      var buttons = document.querySelectorAll('.bill-toggle button')
      if (!grid || !buttons.length) return
      function setTerm(term) {
        grid.setAttribute('data-term', term)
        buttons.forEach(function (b) {
          var on = b.getAttribute('data-term') === term
          b.classList.toggle('active', on)
          b.setAttribute('aria-selected', on ? 'true' : 'false')
        })
        grid.querySelectorAll('[data-buy-yearly]').forEach(function (a) {
          var href = term === 'lifetime' ? a.getAttribute('data-buy-lifetime') : a.getAttribute('data-buy-yearly')
          if (href) a.setAttribute('href', href)
        })
      }
      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          setTerm(btn.getAttribute('data-term'))
        })
      })
    })()
  </script>
</section>
