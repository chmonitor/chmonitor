---
import { loadLatestChangelogVersion } from '../data/changelog-features'
import { useCases } from '../data/use-cases'
import ThemeToggle from './ThemeToggle.astro'

interface Props {
  /** Prefix for on-site paths. Empty on landing; blog passes https://chmonitor.dev. */
  origin?: string
}

const { origin = '' } = Astro.props
const to = (path: string) => `${origin}${path}`
const latestVersion = loadLatestChangelogVersion()
const foot = 'text-sm text-muted-foreground transition-colors hover:text-foreground'
---
  <footer class="border-t border-border">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-12 sm:py-16">
      <div class="flex flex-col gap-10 sm:gap-12 lg:flex-row lg:justify-between">
        <div class="max-w-xs">
          <a class="brand flex items-center gap-2.5 text-base font-semibold tracking-tight" href={to('/')}>
            <span class="mark" aria-hidden="true">
              <img src="/brand/logo-chmonitor.svg" alt="chmonitor" />
            </span>
            chmonitor
          </a>
          <p class="mt-4 text-pretty text-sm text-muted-foreground">chmonitor reads your cluster's system tables and turns them into views your whole team can act on, no more memorizing table names or hand-writing diagnostic SQL.</p>
        </div>
        <div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:flex sm:flex-wrap sm:gap-x-12">
          <div class="min-w-0 sm:min-w-36">
            <h5 class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Product</h5>
            <div class="mt-3 flex flex-col gap-2.5">
              <a class={foot} href={to('/#top')}>Overview</a>
              <a class={foot} href={to('/#features')}>Features</a>
              <a class={foot} href={to('/pricing')}>Pricing</a>
              <a class={foot} href={to('/customers')}>Customers</a>
              <a class={foot} href={to('/license/register')}>Buy a license</a>
              <a class={foot} href={to('/license/lookup')}>Look up a license</a>
              <a class={foot} href={to('/cli')}>CLI</a>
              <a class={foot} href="https://dash.chmonitor.dev" target="_blank" rel="noopener">Dashboard</a>
              <a class={foot} href="https://blog.chmonitor.dev">Blog</a>
              <a class={foot} href="https://blog.chmonitor.dev/rss.xml">RSS</a>
            </div>
          </div>
          <div class="min-w-0 sm:min-w-36">
            <h5 class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Use cases</h5>
            <div class="mt-3 flex flex-col gap-2.5">
              <a class={foot} href={to('/features/ai-agent')}>AI Agent</a>
              {useCases.map((u) => (
                <a class={foot} href={to(`/${u.slug}`)}>{u.eyebrow}</a>
              ))}
            </div>
          </div>
          <div class="min-w-0 sm:min-w-36">
            <h5 class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Open source</h5>
            <div class="mt-3 flex flex-col gap-2.5">
              <a class={foot} href="https://github.com/chmonitor/chmonitor" target="_blank" rel="noopener">GitHub</a>
              <a class={foot} href="https://docs.chmonitor.dev" target="_blank" rel="noopener">Documentation</a>
              <a class={foot} href="https://github.com/chmonitor/chmonitor/issues" target="_blank" rel="noopener">Issues</a>
              <a class={foot} href="https://github.com/chmonitor/chmonitor/releases" target="_blank" rel="noopener">Releases</a>
              <a class={foot} href={latestVersion ? to(`/changelog#v${latestVersion}`) : to('/changelog')}>
                Changelog{latestVersion && <span class="font-mono text-xs"> · v{latestVersion}</span>}
              </a>
            </div>
          </div>
          <div class="min-w-0 sm:min-w-36">
            <h5 class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Legal &amp; trust</h5>
            <div class="mt-3 flex flex-col gap-2.5">
              <a class={foot} href="https://github.com/chmonitor/chmonitor/blob/main/LICENSE" target="_blank" rel="noopener">License (GPL-3.0)</a>
              <a class={foot} href="https://docs.chmonitor.dev/operate/advanced/commercial-license">Commercial license</a>
              <a class={foot} href="https://github.com/chmonitor/chmonitor/security" target="_blank" rel="noopener">Security policy</a>
              <a class={foot} href={to('/brand')}>Brand</a>
            </div>
          </div>
        </div>
      </div>
      <div class="mt-10 sm:mt-12 flex flex-col sm:flex-row sm:flex-wrap items-start sm:items-center justify-between gap-2 sm:gap-3 border-t border-border pt-6 text-sm text-muted-foreground">
        <span>© 2026 chmonitor · Open source (GPL-3.0)</span>
        <div class="flex items-center gap-3">
          <span class="font-mono text-xs">Not affiliated with ClickHouse, Inc.</span>
          {/* Theme toggle (moved from the top nav) — wired globally via
              .theme-toggle in Base.astro (CSS + click handler). */}
          <ThemeToggle />
        </div>
      </div>
    </div>
  </footer>
