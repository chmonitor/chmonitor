# apps/cloud-hooks — Polar webhooks + license checkout + ops notifications
# Secrets: .env.local / wrangler secret put. Non-secret Polar product ids belong here,
# not on apps/dashboard.

# ── Polar license checkout ───────────────────────────────────────────────────
# CHM_POLAR_SERVER=production
# CHM_POLAR_LICENSE_TEAM_YEARLY=
# CHM_POLAR_LICENSE_TEAM_LIFETIME=
# CHM_POLAR_LICENSE_UNLIMITED_YEARLY=
# CHM_POLAR_LICENSE_UNLIMITED_LIFETIME=
# CHM_LICENSE_SUCCESS_ORIGIN=https://chmonitor.dev
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=

# ── Clerk lifecycle webhooks ─────────────────────────────────────────────────
# CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SECRET=

# ── Telegram ops notifications ───────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── GitHub exception filing (PAT fallback) ─────────────────────────────────────
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=chmonitor/chmonitor
# CHM_EXCEPTION_ISSUE_LABELS=bug,cloudflare-exception
# CHM_EXCEPTION_MAX_ISSUES_PER_RUN=5
# CHM_EXCEPTION_SCRIPTS=chmonitor-dash,chmonitor-hooks
# CHM_ISSUE_WATCH_EXCLUDE_LABELS=cloudflare-exception
# CHM_ISSUE_WATCH_MAX_PER_RUN=10

# ── GitHub App exception filing (preferred over PAT) ─────────────────────────
# GH_APP_ID=
# GH_APP_PRIVATE_KEY=
# GH_APP_INSTALLATION_ID=

# ── Cloudflare Workers observability (exception scan) ────────────────────────
# CF_ACCOUNT_ID=
# CF_OBSERVABILITY_API_TOKEN=
