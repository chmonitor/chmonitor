# CHM_POLAR_LICENSE_TEAM_LIFETIME=
# CHM_POLAR_LICENSE_UNLIMITED_YEARLY=
# CHM_POLAR_LICENSE_UNLIMITED_LIFETIME=
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
