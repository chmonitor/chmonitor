# chmonitor dashboard — self-hosted template
# Copy to .env.local. Same names work on Docker, Kubernetes, and a self-built Worker.
# Set each dual-surface flag once as CHM_* — vite.config.ts derives the client VITE_*.
# Full list: docs/content/reference/environment-variables.mdx
# Secrets: placeholders only. Never commit real values.

# ── Connection (required) ───────────────────────────────────────────────────
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
# CLICKHOUSE_NAME=localhost
# SSRF opt-in for private, loopback, link-local, and Tailscale hosts.
# true | 1 | yes | on | cloud. Cloud mode forces this off.
# CHM_ALLOW_PRIVATE_HOSTS=false
# Table query row cap. Default 10000. 0 disables.
# CHM_TABLE_MAX_RESULT_ROWS=10000
# Trust X-Real-IP / X-Forwarded-For. Unset: Cloudflare runtime only.
# true | 1 | cloud trust them everywhere. yes is not true here.
# CHM_TRUST_PROXY_HEADERS=
# CREATE USER / GRANT / REVOKE. Only the exact string true enables it. 1 stays off.
# CLICKHOUSE_MANAGEMENT_ENABLED=false

# ── Auth ────────────────────────────────────────────────────────────────────
# none (default) | clerk | trusted | proxy
# CHM_AUTH_PROVIDER=none
# CHM_CLERK_PUBLISHABLE_KEY=pk_...
# CLERK_SECRET_KEY=sk_...
# Signing secret for chm_ API keys (MCP / CLI). Also required to enable device login.
# CHM_API_KEY_SECRET=
# CLI device login (chm auth login). auto | true | false — default auto:
#   cloud → on when CHM_API_KEY_SECRET is set; self-hosted/OSS → off (trusted LAN).
# Set true on self-hosted to opt in. With CHM_AUTH_PROVIDER=none this is
# device-only approve (no Clerk) — anyone who can open /device can mint a token.
# CHM_DEVICE_LOGIN=auto
# Subject embedded in device-only tokens (auth=none). Default: self-hosted
# CHM_DEVICE_LOGIN_SUBJECT=self-hosted

# ── Agent / LLM ─────────────────────────────────────────────────────────────
# ANYROUTER_API_KEY=
# LLM_API_KEY=
# PROMPTFOO_API_KEY=   # optional: share live eval reports to promptfoo.app
# LLM_MODEL=anyrouter:anyrouter/free
# CHM_FEATURE_AGENT_ACCESS=public
# Feature-permission file (TOML or YAML `features` table). Env vars win over it.
# CHM_CONFIG_FILE=/etc/clickhouse-monitor/config.toml
# CHM_AGENT_FIRECRAWL_MCP=true
# Comma-separated hostnames Firecrawl may scrape/crawl/map. Empty = unrestricted.
# Apex tokens also match subdomains (`clickhouse.com` covers `docs.clickhouse.com`).
# Leading `*.` is subdomain-only (`*.example.com` does not match the apex).
# CHM_AGENT_FIRECRAWL_ALLOW_DOMAINS=clickhouse.com,chmonitor.dev,github.com
# "Sign in with AnyRouter" in the agent: users sign in with their own AnyRouter
# account instead of using the deployment key. Default false. Storing a
# signed-in user's token server-side also needs the CHM_CLOUD_D1 binding and
# CLERK_SECRET_KEY (or CHM_USER_CONNECTIONS_ENCRYPTION_KEY).
# CHM_AGENT_ANYROUTER_SIGNIN_ENABLED=false

# ── Cloud / demo (hosted product; leave unset for OSS) ──────────────────────
# CHM_DEPLOYMENT_MODE=oss
# CHM_CLOUD_MODE=false
# CHM_CLOUD_DEMO_HOSTS=

# ── Features (defaults are fine for OSS) ────────────────────────────────────
# CHM_FEATURE_POSTGRES_SOURCE=false
# CHM_FEATURE_USER_CONNECTIONS_DB=false
# CHM_FEATURE_CONVERSATION_DB=false

# ── Alerts: declarative config (no metadata DB needed) ─────────────────────
# Alert DEFINITIONS (rules, routing, channels, webhook targets, quiet hours,
# maintenance windows, digest) can be declared here. Alert STATE, ACKs and
# dismissals cannot: without D1/Postgres they live in memory, reset on restart,
# and ACK returns 501.
# Directory of YAML files, one per concern: alerts, routing, channels,
# quiet-hours, maintenance, digest (`<concern>.yaml`). Mount a ConfigMap here.
# Precedence: D1/Postgres > file > env > default. Read once at startup.
# Missing dir = no-op. Bad files/entries are skipped with a warning, never fatal.
# Secrets never go in these files: name an env var (`secretEnv`, `urlEnv`,
# `headersEnv`) and set that variable in a Secret / .env.local.
# Docs: /guide/features/health#run-alerts-without-a-metadata-database
# CHM_HEALTH_CONFIG_DIRECTORY=/etc/chmonitor/health.d

# ── Observability ───────────────────────────────────────────────────────────
# CHM_SENTRY_DSN=

# Polar license checkout lives on landing + apps/cloud-hooks, not this app.
# Do not set CHM_POLAR_* here. See apps/cloud-hooks/.env.example.
#
# Optional: Polar checkout id from a commercial-license receipt (honor system).
# Sent on the daily telemetry ping when telemetry is on. Does not unlock features.
# CHM_LICENSE_KEY=
