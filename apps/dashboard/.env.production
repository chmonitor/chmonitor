# Hosted dash.chmonitor.dev — committed non-secrets only.
# vite + patch-wrangler-env.ts both read this file. Set CHM_* once.
# Secrets: .env.production.local / scripts/set-secrets.ts.

# ── Deployment mode ─────────────────────────────────────────────────────────
CHM_DEPLOYMENT_MODE=cloud

# Clerk publishable key: CI / .env.production.local (not committed).
# CHM_CLERK_PUBLISHABLE_KEY=pk_live_...
# AI agent access: public | authenticated. Cloud keeps the agent sign-in-gated
# (anonymous visitors get read-only browsing, not the write-capable agent).
CHM_FEATURE_AGENT_ACCESS=authenticated
# Postgres as a monitored source (beta) — on for cloud. Enables the setup-page
# engine chooser, per-user Postgres connections, /postgres pages, pg insights,
# and the agent's postgres tools. OSS stays fail-closed (off unless set).
CHM_FEATURE_POSTGRES_SOURCE=true

# ── ClickHouse (demo host) ──────────────────────────────────────────────────
# Localhost placeholders — the real demo host topology is injected at deploy from
# CI secrets (CLICKHOUSE_HOST/USER/NAME) so it never lands in the public repo.
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_NAME=localhost
CLICKHOUSE_MAX_EXECUTION_TIME=60
# Public-demo allowlist (CLICKHOUSE_NAME). Topology notes: docs/knowledge/cloud-saas-mode.md
CHM_CLOUD_DEMO_HOSTS=duet-ubuntu,clickhouse-aws,openclaw

# Polar license product ids (checkout is served by apps/cloud-hooks).
CHM_POLAR_SERVER=production
CHM_POLAR_LICENSE_TEAM_YEARLY=a400543b-db5e-4d77-b0cf-0b301c9ba851
CHM_POLAR_LICENSE_TEAM_LIFETIME=5e346773-1c77-41c0-bc10-243d275ef3d0
CHM_POLAR_LICENSE_UNLIMITED_YEARLY=eeeb0b9b-6116-43df-bce2-46c9fce447fc
CHM_POLAR_LICENSE_UNLIMITED_LIFETIME=a66e3980-29f0-4975-8558-863679fb0dd7

# ── Headless health-sweep (cron alerting) ───────────────────────────────────
# Enables the scheduled health-sweep (wrangler.toml `*/10 * * * *` → GET
# /api/cron/health-sweep). The route still requires the CRON_SECRET secret
# (set via scripts/set-secrets.ts). When unset this defaults to enabled iff
# CRON_SECRET is configured; we set it explicitly here so the hosted product's
# alerting runs unattended. Set to false to pause scheduled sweeps without
# removing the cron. See docs/content/guide/features/health.mdx.
CHM_HEALTH_SWEEP_ENABLED=true

# ── Runtime / platform ──────────────────────────────────────────────────────
# Marks the Cloudflare Worker runtime (set only in the worker, not Docker/Node).
CLOUDFLARE_WORKERS=1
# Default AI model — PUBLIC preset only (keeps the repo generic/OSS). chmonitor's
# own deploy overrides this with its private preset in .env.production.local / CI.
LLM_MODEL=anyrouter:anyrouter/free
# OpenRouter/AnyRouter attribution (non-secret; safe public default).
OPENROUTER_REFERER=https://chmonitor.dev
OPENROUTER_APP_NAME=chmonitor
# AgentState conversation store: the AGENTSTATE_API_KEY secret alone activates
# the backend. All other AgentState knobs (base URL, AI-enrich) use code
# defaults — keep them unset here.

# ── Sentry (error tracking) ─────────────────────────────────────────────────
# The DSN is a PUBLIC client-side value (shipped in the browser bundle), so it
# is safe to commit. Single canonical name: vite inlines it as the client
# VITE_SENTRY_DSN AND patch-wrangler-env.ts injects it as a Worker [var] for the
# server SDK. Self-hosted (OSS) builds leave it blank → Sentry disabled. The
# build-time SENTRY_AUTH_TOKEN (source-map upload) is a SECRET — GitHub secret
# only, never here. See docs/knowledge/observability-sentry.md.
CHM_SENTRY_DSN=https://fb45a9aa2583ed0de2e4274579574c0b@o205923.ingest.us.sentry.io/4511653166579712
CHM_SENTRY_ENVIRONMENT=production
CHM_SENTRY_TRACES_SAMPLE_RATE=0.1

# Product analytics (PostHog). The project key is a PUBLIC client value (it ships
# in the browser bundle), so committing it here is intentional and consistent
# with CHM_SENTRY_DSN above. Inlined as VITE_ANALYTICS_KEY for the browser and
# injected as a Worker [var] (patch-wrangler-env.ts) for server-side capture.
CHM_ANALYTICS_KEY=phc_zTJZXoK3jfcu6389msZ5casR8jcZSLSVurLwXSniwugM
CHM_ANALYTICS_HOST=https://us.i.posthog.com

# ── Client-only (build-time inlined; never a worker var) ────────────────────
# Deployment dimension for telemetry.
VITE_DEPLOY_TARGET=cf
